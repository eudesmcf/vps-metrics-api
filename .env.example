# Gere um valor forte no terminal com: openssl rand -hex 32
# Use um resultado para API_TOKEN e gere outro para PRIVATE_PORTAL_PASSWORD.
API_TOKEN=change-me
PRIVATE_PORTAL_USER=admin
PRIVATE_PORTAL_PASSWORD=change-me-too
# Hostname que deve abrir o Swagger diretamente, por exemplo: docs.example.com
DOCS_HOST=
TIMEZONE=America/Sao_Paulo
HOST=0.0.0.0
PORT=8000
DISK_PATH=/
DOCKER_HOST=
GA_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
GA_CACHE_SECONDS=300
CORS_ORIGINS=
